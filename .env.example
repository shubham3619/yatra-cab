# ─────────────────────────────────────────────────────────────
# YatraCab — root env template.
# Copy to .env at the repo root. Both backends (server-app,
# server-admin) read from this single file for local dev.
# In production give each service its own env / secret manager.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/yatracab

# ── JWT (change these in production) ────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── server-app (customer + driver) ──────────────────────────
APP_PORT=5000
# Comma-separated allowed browser origins (customer + driver portals)
APP_CLIENT_URLS=http://localhost:5173,http://localhost:5174

# ── server-admin (independent, hardened) ────────────────────
ADMIN_PORT=5100
ADMIN_CLIENT_URLS=http://localhost:5175

# ── OTP delivery (Gmail SMTP via nodemailer) ────────────────
# Create an App Password at https://myaccount.google.com/apppasswords
# If left blank, OTP is logged to the server console and returned in
# dev responses (devOtp) so the app is fully runnable without email.
OTP_CHANNEL=email
GMAIL_USER=
GMAIL_APP_PASSWORD=
OTP_FROM_NAME=YatraCab
# Fixed OTP for seeded demo accounts (dev convenience)
DEV_OTP=123456

# ── Payments ────────────────────────────────────────────────
# mock  -> auto-succeeds, no external calls (default for now)
# razorpay -> real gateway (fill keys below) once ready to test live
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# ── Business defaults ───────────────────────────────────────
DEFAULT_FEE_PERCENT=10
FREE_CANCEL_WINDOW_HOURS=6
CANCEL_PROCESSING_FEE=50

# ── Pay-to-Connect + Referral (v2) ──────────────────────────
# Commission charged to the DRIVER's wallet when a rider accepts (bidding,
# seat-share, daily-route). The rider pays the fare directly to the driver.
COMMISSION_PERCENT=8
# Free starter wallet credit for a new driver (pre-funds first rides).
DRIVER_WELCOME_CREDIT=200
# Customer referral: signup cashback points (L1); L2 gets 40% of this.
REFERRAL_SIGNUP_POINTS=50
# 1 point = this many ₹ off the online fee on redemption.
POINT_VALUE=1
# Driver multi-level referral shares (of a ride's platform commission) are
# fixed in code: L1 15% · L2 8% · L3 4% · L4 3%.

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_APP_API_URL=http://localhost:5000/api
VITE_ADMIN_API_URL=http://localhost:5100/api
VITE_SOCKET_URL=http://localhost:5000
